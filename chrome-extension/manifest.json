{
  "manifest_version": 3,
  "name": "SparXion Chat Xport",
  "description": "Export AI conversations to Markdown locally. Supports Grok, Claude, Perplexity, ChatGPT, Gemini, Meta AI, and Mistral. Private — nothing leaves your device.",
  "version": "1.2.2",
  "permissions": [
    "scripting",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://claude.ai/*",
    "https://www.claude.ai/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://chatgpt.com/*",
    "https://www.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://chat.mistral.ai/*",
    "https://lechat.mistral.ai/*"
  ],
  "action": {
    "default_title": "Save Chat — on Perplexity in Comet, click for console export help",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["perplexity-comet-export.js", "comet-help.html", "comet-help.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://www.grok.com/*",
        "https://claude.ai/*",
        "https://www.claude.ai/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://chatgpt.com/*",
        "https://www.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://chat.mistral.ai/*",
        "https://lechat.mistral.ai/*"
      ],
      "all_frames": true,
      "js": [
        "normalize-x-grok-paste.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
